DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me
DB_NAME=flux
DB_USER=flux
DB_PASSWORD=flux
DB_HOST=db
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5800,http://127.0.0.1:5800

# Celery broker
REDIS_URL=redis://redis:6379/0

# AI (embeddings run locally, the LLM needs a key)
EMBEDDING_CACHE_DIR=/models
AI_ENABLED=false
ANTHROPIC_API_KEY=
