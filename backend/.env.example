DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-insecure-key
DB_NAME=flux
DB_USER=flux
DB_PASSWORD=flux
DB_HOST=localhost
DB_PORT=5434
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery broker (started by `make dev`)
REDIS_URL=redis://localhost:6380/0

# --- AI assistant: pick ONE provider ---------------------------------------------------
AI_ENABLED=false
# anthropic | gemini | groq | openrouter | mistral | ollama | openai_compatible
AI_PROVIDER=gemini
# Required for every provider except anthropic. Use a model your account can call today:
# free tiers and model lists change often, so nothing is hard coded.
AI_MODEL=
# Key for the provider above. Or use GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY /
# MISTRAL_API_KEY / ANTHROPIC_API_KEY (a vendor key always wins).
AI_API_KEY=
# Override the preset URL (needed for openai_compatible).
# For Ollama running next to the backend (not in Docker), uncomment:
# AI_BASE_URL=http://localhost:11434/v1
#
# Gemini: free key from Google AI Studio. Free tier prompts may be used by Google to improve its products.
# Ollama (local, no key): AI_PROVIDER=ollama, AI_MODEL=<a pulled model that supports tools>.
#   Start Ollama with OLLAMA_HOST=0.0.0.0 so the containers can reach it (host.docker.internal).
#   For a backend running outside Docker use AI_BASE_URL=http://localhost:11434/v1.
